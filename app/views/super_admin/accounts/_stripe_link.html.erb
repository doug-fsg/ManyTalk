<% account = page.resource %>
<% attrs = (account.custom_attributes || {}).with_indifferent_access %>
<% stripe_customer_id = attrs[:stripe_customer_id].presence %>
<% billing_state = stripe_billing_state(attrs) %>
<% seat_count = account.users.count %>
<% licensed_seats = attrs[:subscribed_quantity] %>
<% link_choices = stripe_link_choices %>

<section class="main-content__body stripe-billing">
  <hr />

  <header class="stripe-billing__header" role="banner">
    <div>
      <h2 class="stripe-billing__title">Cobrança Stripe</h2>
      <div class="stripe-billing__badges">
        <span class="<%= stripe_status_badge_classes(billing_state[:key]) %>">
          <%= billing_state[:label] %>
        </span>
        <span class="stripe-billing__badge stripe-billing__badge--neutral">
          <%= stripe_mode_label %>
        </span>
      </div>
      <p class="stripe-billing__description">
        Vincule um customer existente no Stripe. Apenas consulta assinatura — nada é criado no Stripe.
      </p>
    </div>

    <% if stripe_customer_id.present? %>
      <%= link_to 'Abrir no Stripe',
                  stripe_dashboard_customer_url(stripe_customer_id),
                  target: '_blank',
                  rel: 'noopener noreferrer',
                  class: 'button button--alt' %>
    <% end %>
  </header>

  <% if ActiveModel::Type::Boolean.new.cast(attrs[:is_creating_customer]) %>
    <div class="stripe-billing__notice stripe-billing__notice--warning" role="status">
      Flag legada <code>is_creating_customer</code> ativa. Auto-provision desligado — nenhum recurso será criado no Stripe.
    </div>
  <% end %>

  <% if account.billing_locked? && account.active? %>
    <div class="stripe-billing__notice stripe-billing__notice--warning" role="status">
      Bloqueio de cobrança ativo (<code><%= attrs[:subscription_status] %></code>).
      O status da account continua <strong>active</strong> — o dashboard mostra o modal de cobrança, não a tela de suspensão.
    </div>
  <% end %>
  <% if account.suspended? %>
    <div class="stripe-billing__notice stripe-billing__notice--warning" role="status">
      Suspensão manual: usuários entram em <code>/suspended</code>. O webhook do Stripe não altera esse status.
    </div>
  <% end %>

  <% unless stripe_auto_provision_enabled? %>
    <div class="stripe-billing__notice stripe-billing__notice--info" role="status">
      Auto-provision <strong>desativado</strong> (recomendado). Use o formulário abaixo para vincular customers existentes.
    </div>
  <% end %>

  <% if stripe_customer_id.present? %>
    <div class="stripe-billing__overview">
      <dl class="stripe-billing__summary">
        <div class="stripe-billing__summary-item">
          <dt>Cliente</dt>
          <dd><%= attrs[:stripe_customer_name].presence || '—' %></dd>
        </div>
        <div class="stripe-billing__summary-item">
          <dt>E-mail</dt>
          <dd><%= attrs[:stripe_customer_email].presence || '—' %></dd>
        </div>
        <div class="stripe-billing__summary-item">
          <dt>Plano</dt>
          <dd><%= attrs[:plan_name].presence || '—' %></dd>
        </div>
        <div class="stripe-billing__summary-item">
          <dt>Assentos</dt>
          <dd class="is-mono">
            <%= seat_count %><% if licensed_seats.present? %> / <%= licensed_seats %> licenciados<% end %>
          </dd>
        </div>
        <div class="stripe-billing__summary-item">
          <dt>Status da assinatura</dt>
          <dd><%= attrs[:subscription_status].presence || '—' %></dd>
        </div>
        <div class="stripe-billing__summary-item">
          <dt>Fim do período atual</dt>
          <dd><%= format_stripe_timestamp(attrs[:subscription_ends_on]) %></dd>
        </div>
      </dl>

      <details class="stripe-billing__technical">
        <summary>Identificadores Stripe</summary>
        <dl class="stripe-billing__technical-list">
          <% stripe_technical_fields(attrs).each do |label, value| %>
            <div class="stripe-billing__technical-item">
              <dt><%= label %></dt>
              <dd translate="no"><%= value.presence || '—' %></dd>
            </div>
          <% end %>
        </dl>
      </details>
    </div>
  <% else %>
    <p class="stripe-billing__empty">Nenhum customer Stripe vinculado a esta account.</p>
  <% end %>

  <fieldset class="field-unit--nested stripe-billing__form-panel">
    <legend><%= stripe_customer_id.present? ? 'Atualizar vínculo' : 'Vincular customer' %></legend>

    <%= form_for([:link_stripe, namespace, page.resource], method: :post, html: { class: 'form' }) do %>
      <div class="field-unit field-unit--string">
        <div class="field-unit__label">
          <label for="stripe_customer_id">Stripe Customer ID</label>
        </div>
        <div class="field-unit__field">
          <%= text_field_tag :stripe_customer_id,
                             link_choices&.dig(:stripe_customer_id) || stripe_customer_id,
                             id: 'stripe_customer_id',
                             placeholder: 'cus_…',
                             autocomplete: 'off',
                             spellcheck: false %>
          <p class="stripe-billing__hint">
            Cole o ID <code>cus_</code> do Stripe. Se houver mais de uma assinatura ou item, selecione abaixo.
          </p>
        </div>
      </div>

      <% if link_choices.present? %>
        <div class="stripe-billing__choices" role="status">
          <p class="stripe-billing__choices-title">Selecione qual assinatura ou item usar nesta account.</p>

          <% if link_choices[:choice_type] == 'subscription' %>
            <div class="field-unit field-unit--string">
              <div class="field-unit__label">
                <label for="stripe_subscription_id">Assinatura Stripe</label>
              </div>
              <div class="field-unit__field">
                <%= select_tag :stripe_subscription_id,
                               options_for_select(
                                 link_choices[:choices].map { |choice| [choice['label'], choice['id']] },
                                 params[:stripe_subscription_id]
                               ),
                               include_blank: 'Selecione uma assinatura…',
                               id: 'stripe_subscription_id' %>
              </div>
            </div>
          <% elsif link_choices[:choice_type] == 'subscription_item' %>
            <%= hidden_field_tag :stripe_subscription_id, link_choices[:stripe_subscription_id] %>
            <div class="field-unit field-unit--string">
              <div class="field-unit__label">
                <label for="stripe_subscription_item_id">Item da assinatura</label>
              </div>
              <div class="field-unit__field">
                <%= select_tag :stripe_subscription_item_id,
                               options_for_select(
                                 link_choices[:choices].map { |choice| [choice['label'], choice['id']] },
                                 params[:stripe_subscription_item_id]
                               ),
                               include_blank: 'Selecione um item…',
                               id: 'stripe_subscription_item_id' %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="stripe-billing__form-actions">
        <%= submit_tag(stripe_customer_id.present? ? 'Atualizar vínculo' : 'Vincular customer', class: 'button') %>
        <% if stripe_customer_id.present? %>
          <p class="stripe-billing__form-note">
            Enviar novamente substitui o vínculo e reconsulta os dados no Stripe.
          </p>
        <% end %>
      </div>
    <% end %>
  </fieldset>
</section>
