<% content_for(:title) do %>
  Anúncios de Features
<% end %>

<header class="flex mx-8 py-4 items-center border-b border-solid border-slate-100" role="banner">
  <div class="border border-solid border-slate-100 text-slate-700 mr-4 p-2 rounded-full">
    <svg width="24" height="24"><use xlink:href="#icon-megaphone-line" /></svg>
  </div>
  <div class="flex flex-col h-14 justify-center">
    <h1 class="text-base font-medium leading-6 text-slate-900" id="page-title">
      <%= content_for(:title) %>
    </h1>
    <p class="text-sm font-normal leading-5 text-slate-500 m-0">Gerencie anúncios de novas funcionalidades para usuários</p>
  </div>
</header>

<section class="main-content__body">
  <div class="bg-white py-2 px-3">
    <div class="mb-4 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-slate-900">Lista de Anúncios</h2>
      <%= link_to 'Novo Anúncio', new_super_admin_announcement_path, 
          class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-woot-500 hover:bg-woot-600' %>
    </div>

    <% if @announcements.any? %>
      <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Título</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Público</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Publicado</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @announcements.each do |announcement| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= announcement['id'] %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">
                    <%= announcement['title']['pt_BR'] %>
                  </div>
                  <div class="text-sm text-gray-500">
                    <%= announcement['title']['en'] %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% announcement['target_roles'].each do |role| %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-1">
                      <%= role == 'administrator' ? 'Admin' : 'Agente' %>
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if announcement['active'] %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Ativo
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      Inativo
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= Time.parse(announcement['published_at']).strftime('%d/%m/%Y %H:%M') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <%= link_to 'Remover', super_admin_announcement_path(announcement['id']), 
                      method: :delete, 
                      data: { confirm: 'Tem certeza que deseja remover este anúncio?' },
                      class: 'text-red-600 hover:text-red-900' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-10 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2M7 4h10" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Nenhum anúncio</h3>
        <p class="mt-1 text-sm text-gray-500">Comece criando um novo anúncio de funcionalidade.</p>
        <div class="mt-6">
          <%= link_to 'Novo Anúncio', new_super_admin_announcement_path, 
              class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-woot-500 hover:bg-woot-600' %>
        </div>
      </div>
    <% end %>
  </div>
</section>
