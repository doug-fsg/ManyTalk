<% content_for(:title) do %>
  Novo Anúncio
<% end %>

<header class="flex mx-8 py-4 items-center border-b border-solid border-slate-100" role="banner">
  <div class="border border-solid border-slate-100 text-slate-700 mr-4 p-2 rounded-full">
    <svg width="24" height="24"><use xlink:href="#icon-megaphone-line" /></svg>
  </div>
  <div class="flex flex-col h-14 justify-center">
    <h1 class="text-base font-medium leading-6 text-slate-900" id="page-title">
      <%= content_for(:title) %>
    </h1>
    <p class="text-sm font-normal leading-5 text-slate-500 m-0">Criar novo anúncio de funcionalidade</p>
  </div>
</header>

<section class="main-content__body">
  <div class="max-w-4xl mx-auto p-8">
    <%= form_with url: super_admin_announcements_path, multipart: true, local: true, class: "space-y-6" do |f| %>
      
      <!-- ID único -->
      <div>
        <%= f.label :id, "ID único", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :id, required: true, placeholder: "ex: feature-kanban-2024", 
            class: "w-full rounded-md border-gray-300 shadow-sm focus:border-woot-500 focus:ring-woot-500" %>
        <p class="text-xs text-gray-500 mt-1">Use um ID único e descritivo (sem espaços, use hífens)</p>
      </div>

      <!-- Títulos -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :title_pt, "Título (Português)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :title_pt, required: true, placeholder: "🎉 Nova funcionalidade: Kanban", 
              class: "w-full rounded-md border-gray-300 shadow-sm focus:border-woot-500 focus:ring-woot-500" %>
        </div>
        
        <div>
          <%= f.label :title_en, "Título (English)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :title_en, required: true, placeholder: "🎉 New feature: Kanban Board", 
              class: "w-full rounded-md border-gray-300 shadow-sm focus:border-woot-500 focus:ring-woot-500" %>
        </div>
      </div>

      <!-- Descrições -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :desc_pt, "Descrição (Português)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :desc_pt, rows: 4, required: true, 
              placeholder: "Agora você pode organizar suas conversas visualmente em um quadro Kanban...", 
              class: "w-full rounded-md border-gray-300 shadow-sm focus:border-woot-500 focus:ring-woot-500" %>
        </div>
        
        <div>
          <%= f.label :desc_en, "Descrição (English)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :desc_en, rows: 4, required: true, 
              placeholder: "Now you can organize your conversations visually in a Kanban board...", 
              class: "w-full rounded-md border-gray-300 shadow-sm focus:border-woot-500 focus:ring-woot-500" %>
        </div>
      </div>

      <!-- Upload de mídia -->
      <div>
        <%= f.label :media, "GIF ou Imagem", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
          <div class="space-y-1 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm text-gray-600">
              <label for="media" class="relative cursor-pointer bg-white rounded-md font-medium text-woot-600 hover:text-woot-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-woot-500">
                <span>Fazer upload de arquivo</span>
                <%= f.file_field :media, accept: "image/*", class: "sr-only" %>
              </label>
              <p class="pl-1">ou arraste e solte</p>
            </div>
            <p class="text-xs text-gray-500">PNG, JPG, GIF até 5MB</p>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-2">Recomendado: GIF animado mostrando a funcionalidade</p>
      </div>

      <!-- Público-alvo -->
      <div>
        <fieldset>
          <legend class="text-sm font-medium text-gray-700 mb-3">Quem deve ver este anúncio?</legend>
          <div class="space-y-3">
            <div class="flex items-center">
              <%= check_box_tag 'roles[]', 'administrator', true, id: 'role_admin', 
                  class: "h-4 w-4 text-woot-600 focus:ring-woot-500 border-gray-300 rounded" %>
              <label for="role_admin" class="ml-3 text-sm text-gray-700">
                <span class="font-medium">Administradores</span>
                <span class="text-gray-500">- Usuários com permissão de admin</span>
              </label>
            </div>
            
            <div class="flex items-center">
              <%= check_box_tag 'roles[]', 'agent', true, id: 'role_agent', 
                  class: "h-4 w-4 text-woot-600 focus:ring-woot-500 border-gray-300 rounded" %>
              <label for="role_agent" class="ml-3 text-sm text-gray-700">
                <span class="font-medium">Agentes</span>
                <span class="text-gray-500">- Usuários que atendem conversas</span>
              </label>
            </div>
          </div>
        </fieldset>
      </div>

      <!-- Status -->
      <div class="flex items-center">
        <%= f.check_box :active, { checked: true }, "1", "0", 
            class: "h-4 w-4 text-woot-600 focus:ring-woot-500 border-gray-300 rounded" %>
        <label for="active" class="ml-3 text-sm font-medium text-gray-700">
          Ativar anúncio (visível para usuários imediatamente)
        </label>
      </div>

      <!-- Preview -->
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Preview</h3>
        <div class="bg-gray-50 p-6 rounded-lg">
          <div class="max-w-md mx-auto bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="bg-gray-200 h-32 flex items-center justify-center">
              <span class="text-gray-500 text-sm">Sua imagem/GIF aparecerá aqui</span>
            </div>
            <div class="p-4">
              <h4 class="font-bold text-gray-900 mb-2">Título do anúncio</h4>
              <p class="text-gray-600 text-sm">Descrição do anúncio aparecerá aqui...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Ações -->
      <div class="flex gap-4 pt-6">
        <%= f.submit 'Publicar Anúncio', 
            class: 'inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-woot-600 hover:bg-woot-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-woot-500' %>
        <%= link_to 'Cancelar', super_admin_announcements_path, 
            class: 'inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-woot-500' %>
      </div>
    <% end %>
  </div>
</section>

<script>
// Preview em tempo real
document.addEventListener('DOMContentLoaded', function() {
  const titlePt = document.querySelector('#title_pt');
  const descPt = document.querySelector('#desc_pt');
  const previewTitle = document.querySelector('.max-w-md h4');
  const previewDesc = document.querySelector('.max-w-md p');
  
  if (titlePt && previewTitle) {
    titlePt.addEventListener('input', function() {
      previewTitle.textContent = this.value || 'Título do anúncio';
    });
  }
  
  if (descPt && previewDesc) {
    descPt.addEventListener('input', function() {
      previewDesc.textContent = this.value || 'Descrição do anúncio aparecerá aqui...';
    });
  }
});
</script>
