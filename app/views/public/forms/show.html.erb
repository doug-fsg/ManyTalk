<!DOCTYPE html>
<html>
  <head>
    <title><%= @account_form.branding['header_title'].presence || @account_form.name %> — <%= @global_config['INSTALLATION_NAME'] %></title>
    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
    <script>
      window.publicFormConfig = <%= raw ({
        accountId: @account.id,
        slug: @account_form.slug,
        status: @account_form.status,
        globalConfig: @global_config
      }).to_json %>;
    </script>
    <%= javascript_pack_tag 'publicForm' %>
    <%= stylesheet_pack_tag 'publicForm' %>
  </head>
  <body>
    <div id="app"></div>
  </body>
</html>
